---
// Small round contact icons (Scholar, website, LinkedIn, email). Labels carry the person's name.
interface Props {
  name: string;
  scholar?: string;
  website?: string;
  linkedin?: string;
  email?: string;
}

const { name, scholar, website, linkedin, email } = Astro.props;

const ICONS = {
  scholar: 'M12 3 1 9l4 2.2v6L12 21l7-3.8v-6l2-1.1V17h2V9L12 3Zm6.8 6L12 12.7 5.2 9 12 5.3 18.8 9ZM17 16l-5 2.7L7 16v-3.6l5 2.7 5-2.7V16Z',
  website: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-2.9a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8ZM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4ZM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3Zm.8 2h3c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16ZM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.4 6.7 8 8Zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4Zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4Zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h3a8 8 0 0 1-4.4 3.6Zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4Z',
  linkedin: 'M6.9 8.8H3.6V20h3.3V8.8ZM5.2 3.5a1.9 1.9 0 1 0 0 3.8 1.9 1.9 0 0 0 0-3.8ZM20.4 13.6c0-3-1.6-5-4.4-5-1.4 0-2.4.8-2.8 1.5V8.8H10V20h3.3v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.3l-.1-6.4Z',
  email: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm9 7.2L4 7.3V17h16V7.3l-8 4.9ZM5.1 7l6.9 4.2L18.9 7H5.1Z',
} as const;

const links = [
  scholar && { kind: 'scholar', href: scholar, label: 'Google Scholar' },
  website && { kind: 'website', href: website, label: 'Website' },
  linkedin && { kind: 'linkedin', href: linkedin, label: 'LinkedIn' },
  email && { kind: 'email', href: `mailto:${email}`, label: 'Email' },
].filter(Boolean) as { kind: keyof typeof ICONS; href: string; label: string }[];
---

{
  links.length > 0 && (
    <ul class="icon-links">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-label={`${link.label}: ${name}`} title={link.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={ICONS[link.kind]} /></svg>
          </a>
        </li>
      ))}
    </ul>
  )
}
