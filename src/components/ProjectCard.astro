---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/paths';

interface Props {
  project: CollectionEntry<'projects'>;
}

// Image-top project card (HuMNet style): figure, short title, one-line tagline. Whole card links.
const { project } = Astro.props;
const { title, short, tagline, summary, cover, coverAlt, coverWidth, coverHeight, funder, year } = project.data;
const heading = short ?? title;
---

<article class="project-card">
  <a class="project-link" href={sitePath(`/projects/${project.id}`)}>
    <div class="project-media">
      {cover ? (
        <img
          src={sitePath(cover)}
          alt={coverAlt ?? ''}
          width={coverWidth ?? 800}
          height={coverHeight ?? 600}
          loading="lazy"
          decoding="async"
        />
      ) : (
        // Typographic stand-in until a figure is chosen for this project.
        <span class="project-media-label" aria-hidden="true">{funder ?? 'Project'}{year ? ` · ${year}` : ''}</span>
      )}
    </div>
    <div class="project-copy">
      <h3>{heading}</h3>
      <p>{tagline ?? (short ? title : summary)}</p>
    </div>
  </a>
</article>
