---
import { getCollection } from 'astro:content';
import { HIGHLIGHT_TABS, isInGroupAuthor } from '../lib/site';

const pubs = await getCollection('publications');
const tabs = HIGHLIGHT_TABS.flatMap((tab, index) => {
  const pub = pubs.find((p) => p.id === tab.pub);
  return pub ? [{ ...tab, pub: pub.data, key: `hl-${index}` }] : [];
});
---

{tabs.length > 0 && (
  <div class="highlight-tabs" data-tabs>
    <div class="tab-list" role="tablist" aria-label="Highlighted publications by research area">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${tab.key}-tab`}
          aria-controls={`${tab.key}-panel`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.area}
        </button>
      ))}
      <span class="tab-indicator" aria-hidden="true"></span>
    </div>

    {tabs.map((tab, i) => (
      <div
        class="tab-panel"
        role="tabpanel"
        id={`${tab.key}-panel`}
        aria-labelledby={`${tab.key}-tab`}
        hidden={i !== 0}
      >
        {/* Typographic stand-in for a first-page image; replace with a figure when supplied. */}
        <div class="paper-cover" aria-hidden="true">
          <span class="paper-venue">{tab.pub.venue}</span>
          <span class="paper-rule"></span>
          <span class="paper-title">{tab.pub.title}</span>
          <span class="paper-lines"><i></i><i></i><i></i><i></i><i></i></span>
          <span class="paper-year">{tab.pub.year}</span>
        </div>
        <div class="paper-copy">
          <p class="kicker">{tab.area}</p>
          <h3>{tab.pub.title}</h3>
          <p class="pub-meta">
            {tab.pub.authors.map((name, j) => (
              <>
                {j > 0 && ', '}
                <span class={isInGroupAuthor(name) ? 'author-ingroup' : undefined}>{name}</span>
              </>
            ))}
          </p>
          <p class="paper-cite"><em>{tab.pub.venue}</em> ({tab.pub.year})</p>
          {tab.pub.doi && (
            <a class="more-link" href={`https://doi.org/${tab.pub.doi}`}>Read the paper</a>
          )}
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .tab-list {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.25rem;
    padding: 0.375rem;
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-sky) 70%, var(--color-white));
  }

  .tab-list button {
    position: relative;
    z-index: 1;
    min-height: 48px;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: calc(var(--radius-card) - 4px);
    background: transparent;
    color: var(--color-text-muted);
    font-weight: 600;
    transition: color var(--dur) var(--ease-out);
  }

  .tab-list button:hover,
  .tab-list button[aria-selected="true"] {
    color: var(--color-primary);
  }

  /* White pill that slides beneath the active tab. */
  .tab-indicator {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: 0;
    width: 0;
    border-radius: calc(var(--radius-card) - 4px);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition:
      transform 420ms var(--ease-out),
      width 420ms var(--ease-out);
  }

  .tab-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    animation: panel-in 520ms var(--ease-out) both;
  }

  .tab-panel[hidden] { display: none; }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(12px); }
  }

  .paper-cover {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    aspect-ratio: 8.5 / 11;
    max-width: 22rem;
    width: 100%;
    margin-inline: auto;
    padding: 2rem 1.75rem;
    border-radius: 6px;
    background: var(--color-white);
    box-shadow: var(--shadow-lg);
    transform: rotate(-1.5deg);
    transition: transform 600ms var(--ease-out);
  }

  .tab-panel:hover .paper-cover { transform: rotate(0) translateY(-4px); }

  .paper-venue {
    color: var(--color-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .paper-rule { height: 3px; background: var(--color-primary); }

  .paper-title {
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .paper-lines { display: grid; gap: 0.55rem; margin-top: auto; }
  .paper-lines i { display: block; height: 6px; border-radius: 3px; background: #e6ebf1; }
  .paper-lines i:nth-child(2n) { width: 86%; }
  .paper-lines i:last-child { width: 58%; }

  .paper-year { color: var(--color-text-muted); font-size: 0.75rem; }

  .paper-copy h3 { font-size: clamp(1.3rem, 2.4vw, 1.75rem); margin-bottom: 1rem; }
  .paper-cite { color: var(--color-text-muted); }
  .paper-copy .more-link { margin-top: 0.5rem; }

  @media (max-width: 760px) {
    .tab-list { grid-auto-flow: row; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tab-list button { font-size: 0.8125rem; line-height: 1.25; }
    .tab-indicator { display: none; }
    .tab-list button[aria-selected="true"] { background: var(--color-white); box-shadow: var(--shadow-sm); }
    .tab-panel { grid-template-columns: 1fr; }
    .paper-cover { max-width: 15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-panel { animation: none; }
    .paper-cover { transform: none; }
  }
</style>

<script>
  // WAI-ARIA tabs: click or arrow keys switch panels; the indicator follows the active tab.
  function initTabs() {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const indicator = root.querySelector<HTMLElement>('.tab-indicator');

      const moveIndicator = (tab: HTMLButtonElement) => {
        if (!indicator) return;
        indicator.style.width = `${tab.offsetWidth}px`;
        indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
      };

      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', String(active));
          t.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !active;
        });
        moveIndicator(tab);
        if (focus) tab.focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (event) => {
          const keys: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
          if (!(event.key in keys)) return;
          event.preventDefault();
          select(tabs[(keys[event.key] + tabs.length) % tabs.length], true);
        });
      });

      const current = tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];
      if (current) {
        // Place the indicator without animating on first paint.
        indicator?.style.setProperty('transition', 'none');
        moveIndicator(current);
        requestAnimationFrame(() => indicator?.style.removeProperty('transition'));
        new ResizeObserver(() => {
          const active = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
          if (active) moveIndicator(active);
        }).observe(root);
      }
    });
  }

  document.addEventListener('astro:page-load', initTabs);
</script>
