---
import { getCollection } from 'astro:content';
import { HIGHLIGHT_PUBS } from '../lib/site';
import { labAuthorMatcher } from '../lib/lab-authors';
import { authorSeparator, natureAuthor } from '../lib/cite';
import { sitePath } from '../lib/paths';

// Hand-picked papers, one tab each, with the article's first page. Tab styles live in editorial.css.
const pubs = await getCollection('publications');
const isInGroupAuthor = await labAuthorMatcher();
const tabs = HIGHLIGHT_PUBS.flatMap((tab, index) => {
  const pub = pubs.find((p) => p.id === tab.pub);
  return pub ? [{ ...tab, pub: pub.data, key: `hl-${index}` }] : [];
});
---

{tabs.length > 0 && (
  <div class="highlight-tabs" data-tabs>
    <div class="tab-list" role="tablist" aria-label="Highlighted publications">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${tab.key}-tab`}
          aria-controls={`${tab.key}-panel`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))}
      <span class="tab-indicator" aria-hidden="true"></span>
    </div>

    {tabs.map((tab, i) => (
      <div
        class="tab-panel highlight-panel"
        role="tabpanel"
        id={`${tab.key}-panel`}
        aria-labelledby={`${tab.key}-tab`}
        hidden={i !== 0}
      >
        <figure class="highlight-figure">
          <img
            src={sitePath(tab.image)}
            alt={`First page of “${tab.pub.title}”`}
            width={tab.width}
            height={tab.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
        <div class="highlight-copy">
          <h3>{tab.pub.title}</h3>
          {tab.pub.abstract && <p class="highlight-abstract">{tab.pub.abstract}</p>}
          {/* Nature-style reference; the whole citation links to the article. Single line on purpose (JSX whitespace). */}
          <p class="highlight-cite">
            {tab.pub.doi ? (
              <a href={`https://doi.org/${tab.pub.doi}`} aria-label={`${tab.pub.title}, ${tab.pub.venue} (${tab.pub.year}), opens the article`}>{tab.pub.authors.map((name, j) => <>{authorSeparator(j, tab.pub.authors.length)}<span class={isInGroupAuthor(name) ? 'author-ingroup' : undefined}>{natureAuthor(name)}</span></>)}{' '}<em>{tab.pub.venue}</em>{tab.pub.volume && <>{' '}<b>{tab.pub.volume}</b></>}{tab.pub.pages && <>, {tab.pub.pages}</>}{` (${tab.pub.year}).`}</a>
            ) : (
              <>{tab.pub.authors.map((name, j) => <>{authorSeparator(j, tab.pub.authors.length)}{natureAuthor(name)}</>)}{' '}<em>{tab.pub.venue}</em>{` (${tab.pub.year}).`}</>
            )}
          </p>
        </div>
      </div>
    ))}
  </div>
)}

<style>
  /* First page of the PDF on the left (narrow), abstract and citation on the right. */
  .highlight-panel {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .highlight-panel[hidden] { display: none; }

  .highlight-figure {
    position: sticky;
    top: 1.5rem;
    margin: 0;
    border: 1px solid var(--rule);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
    background: var(--color-white);
  }

  .highlight-figure img { display: block; width: 100%; height: auto; }

  .highlight-copy { text-align: left; }
  .highlight-copy h3 { margin: 0 0 1rem; font-size: clamp(1.25rem, 2.2vw, 1.55rem); line-height: 1.3; }
  .highlight-abstract { margin: 0 0 1.25rem; color: var(--color-text-muted); font-size: 0.9375rem; line-height: 1.7; hyphens: auto; }
  .highlight-cite { margin: 0; font-size: 0.8125rem; line-height: 1.6; }
  .highlight-cite a { color: var(--color-link); text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 0.2em; }
  .highlight-cite a:hover { color: var(--color-primary); text-decoration-color: currentColor; }

  @media (max-width: 760px) {
    .highlight-panel { grid-template-columns: minmax(0, 1fr); }
    .highlight-figure { position: static; max-width: 14rem; }
  }
</style>

<script>
  import '../scripts/tabs';
</script>
