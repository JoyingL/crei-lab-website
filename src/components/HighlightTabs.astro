---
import { getCollection } from 'astro:content';
import { HIGHLIGHT_PUBS } from '../lib/site';
import { labAuthorMatcher } from '../lib/lab-authors';
import { authorSeparator, natureAuthor } from '../lib/cite';
import { sitePath } from '../lib/paths';

// Hand-picked papers, one tab each, with a figure from the paper. Tab styles live in editorial.css.
const pubs = await getCollection('publications');
const isInGroupAuthor = await labAuthorMatcher();
const tabs = HIGHLIGHT_PUBS.flatMap((tab, index) => {
  const pub = pubs.find((p) => p.id === tab.pub);
  return pub ? [{ ...tab, pub: pub.data, key: `hl-${index}` }] : [];
});
---

{tabs.length > 0 && (
  <div class="highlight-tabs" data-tabs>
    <div class="tab-list" role="tablist" aria-label="Highlighted publications">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${tab.key}-tab`}
          aria-controls={`${tab.key}-panel`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))}
      <span class="tab-indicator" aria-hidden="true"></span>
    </div>

    {tabs.map((tab, i) => (
      <div
        class="tab-panel highlight-panel"
        role="tabpanel"
        id={`${tab.key}-panel`}
        aria-labelledby={`${tab.key}-tab`}
        hidden={i !== 0}
      >
        <figure class="highlight-figure">
          <img
            src={sitePath(tab.image)}
            alt={tab.imageAlt}
            width={tab.width}
            height={tab.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
        <div class="highlight-copy">
          <h3>{tab.pub.title}</h3>
          <p class="pub-meta">
            {tab.pub.authors.map((name, j) => <>{authorSeparator(j, tab.pub.authors.length)}<span class={isInGroupAuthor(name) ? 'author-ingroup' : undefined}>{natureAuthor(name)}</span></>)}
          </p>
          <p class="highlight-cite"><em>{tab.pub.venue}</em> ({tab.pub.year})</p>
          {tab.pub.doi && <a class="more-link" href={`https://doi.org/${tab.pub.doi}`}>View article</a>}
        </div>
      </div>
    ))}
  </div>
)}

<style>
  .highlight-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .highlight-panel[hidden] { display: none; }

  /* Figures vary from tall to very wide; contain them in a fixed-height frame. */
  /* Flex (not grid) so the image's percentage max-height resolves against the frame. */
  .highlight-figure {
    display: flex;
    align-items: center;
    justify-content: center;
    height: clamp(16rem, 32vw, 26rem);
    margin: 0;
    padding: 1rem;
    background: var(--color-white);
    border: 1px solid var(--rule);
  }

  .highlight-figure img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .highlight-copy h3 { margin-bottom: 1rem; font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.3; }
  .highlight-cite { color: var(--color-text-muted); }
  .highlight-copy .more-link { margin-top: 0.5rem; }

  @media (max-width: 760px) {
    .highlight-panel { grid-template-columns: minmax(0, 1fr); }
    .highlight-figure { height: auto; }
    .highlight-figure img { max-height: 20rem; }
  }
</style>

<script>
  import '../scripts/tabs';
</script>
