---
import { sitePath } from '../lib/paths';
import type { CollectionEntry } from 'astro:content';
import IconLinks from './IconLinks.astro';

interface Props {
  person: CollectionEntry<'people'>;
  /** Wide Principal Investigator row with bio (People page). */
  wide?: boolean;
}

const { person, wide = false } = Astro.props;
const { name, title, email, scholar, linkedin, website, photo } = person.data;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('');
// Only the PI file body is public bio text; other bodies hold sourcing notes.
const bio = wide ? person.body?.trim() : undefined;
---

<article class={wide ? 'pi-card' : 'member'}>
  {
    photo ? (
      <img class="member-photo" src={sitePath(photo)} alt={name} width="320" height="320" loading="lazy" />
    ) : (
      // Placeholder until a photo is supplied; decorative, the name follows as text.
      <div class="member-photo member-initials" aria-hidden="true">{initials}</div>
    )
  }
  {wide && <p class="pi-title">{title}</p>}
  <div>
    <h3 class="member-name">{name}</h3>
    {!wide && <p class="member-title">{title}</p>}
  </div>
  <IconLinks name={name} scholar={scholar} website={website} linkedin={linkedin} email={email} />
  {bio && <p class="pi-bio">{bio}</p>}
</article>
