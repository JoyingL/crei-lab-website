---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/paths';
import { hasProfile, initialsOf, profilePath } from '../lib/people';
import IconLinks from './IconLinks.astro';

interface Props {
  person: CollectionEntry<'people'>;
  /** Wide Principal Investigator row with bio (People page). */
  wide?: boolean;
}

const { person, wide = false } = Astro.props;
const { name, title, affiliation, email, scholar, linkedin, website, photo } = person.data;
const initials = initialsOf(name);
// Only the PI file body is public bio text; other files keep sourcing notes as YAML comments.
const bio = wide ? person.body?.trim() : undefined;
// PI links to About; postdocs and Ph.D. students to their profile; others to an external page if any.
const nameHref = wide ? sitePath('/about') : hasProfile(person) ? sitePath(profilePath(person)) : website;
---

{
  wide ? (
    <article class="pi-card">
      {photo ? (
        <img class="member-photo" src={sitePath(photo)} alt="" width="400" height="560" loading="lazy" />
      ) : (
        <div class="member-photo member-initials" aria-hidden="true">{initials}</div>
      )}
      <p class="pi-title">{title}</p>
      <div>
        <h4 class="member-name"><a href={nameHref}>{name}</a></h4>
      </div>
      <IconLinks name={name} scholar={scholar} website={website} linkedin={linkedin} email={email} />
      {bio && <p class="pi-bio">{bio}</p>}
    </article>
  ) : (
    <article class="person">
      {photo ? (
        // Decorative: the name follows as text, so screen readers do not hear it twice.
        <img class="person-photo" src={sitePath(photo)} alt="" width="400" height="500" loading="lazy" />
      ) : (
        <div class="person-photo person-initials" aria-hidden="true">{initials}</div>
      )}
      <h4 class="person-name">{nameHref ? <a href={nameHref}>{name}</a> : name}</h4>
      <p class="person-title">{title}</p>
      <p class="person-affil">{affiliation}</p>
      <IconLinks name={name} scholar={scholar} website={website} linkedin={linkedin} email={email} />
    </article>
  )
}

<style>
  .person {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .person-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    margin-bottom: 0.875rem;
    object-fit: cover;
    object-position: center 25%;
    background: var(--color-sky);
  }

  .person-initials {
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--color-primary) 55%, transparent);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .person-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .person-name a {
    color: var(--color-text);
    text-decoration: none;
  }

  .person-name a:hover,
  .person-name a:focus-visible {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .person-title,
  .person-affil {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .person-affil {
    margin-top: 0.1rem;
    font-size: 0.8125rem;
  }

  .person :global(.icon-links) {
    margin-top: 0.625rem;
  }

  .pi-card .member-name a {
    color: inherit;
    text-decoration: none;
  }

  .pi-card .member-name a:hover,
  .pi-card .member-name a:focus-visible {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
