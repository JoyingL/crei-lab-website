---
import { sitePath } from '../lib/paths';
interface Props {
  title: string;
  body: string;
  image?: string;
  imageAlt?: string;
}
const { title, body, image, imageAlt = '' } = Astro.props;
---

<article class="research-area">
  {image && <img class="research-area-image" src={sitePath(image)} alt={imageAlt} width="960" height="600" loading="lazy" decoding="async" />}
  <div class="research-area-copy">
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
</article>
