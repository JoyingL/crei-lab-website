---
import { sitePath } from '../../lib/paths';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const courses = (await getCollection('teaching')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout title="Teaching" description="Teaching at the Climate Resilient and Equitable Infrastructure Lab.">
  <section class="section">
    <div class="wrap">
      <h1>Teaching</h1>
      <p class="lede">
        Graduate courses in infrastructure risk, resilience, and equity.
      </p>
      {
        courses.length === 0 ? (
          <p class="empty">For course inquiries, contact Farshid Vahedifard.</p>
        ) : (
          courses.map((course) => (
            <article class="pub-item">
              <h2>{course.data.code ? `${course.data.code}: ${course.data.title}` : course.data.title}</h2>
              <p class="pub-meta">
                {[course.data.term, course.data.year].filter(Boolean).join(' ')}
              </p>
              {course.data.description && <p>{course.data.description}</p>}
            </article>
          ))
        )
      }
      <h2>For students and collaborators</h2>
      <p>
        For questions about graduate research or course projects,
        <a href={sitePath('/join')}>contact the lab</a>.
      </p>
    </div>
  </section>
</BaseLayout>
