---
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL } from '../lib/site';
---

<BaseLayout title="Opportunities" description="Student and collaboration inquiries for the Climate Resilient and Equitable Infrastructure Lab.">
  <section class="section">
    <div class="wrap" style="max-width: var(--measure-narrow);">
      <p class="kicker">Opportunities</p>
      <h1>Join Us</h1>
      <p class="lede">
        We welcome inquiries from prospective students and researchers interested in climate
        hazards, soil mechanics, and equitable infrastructure.
      </p>
      <h2>Prospective students</h2>
      <p>
        Our <a href={sitePath('/projects')}>projects</a> and
        <a href={sitePath('/publications')}>publications</a> offer an overview of the questions we
        study. If your interests overlap with our work, please email Farshid Vahedifard with a brief
        introduction, including your academic background, the degree you would like to pursue, and
        the research questions that interest you.
      </p>
      <p>
        Please check the relevant Tufts department or graduate program website for application
        requirements and deadlines.
      </p>
      <h2>Research collaboration</h2>
      <p>
        To discuss a potential collaboration, please email Farshid Vahedifard with a brief
        description of your research question and how it connects with our work.
      </p>
      <h2>Contact</h2>
      <p>
        Farshid Vahedifard<br />
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
  </section>
</BaseLayout>
