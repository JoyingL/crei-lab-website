---
import { sitePath } from '../lib/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAIL } from '../lib/site';
---

<BaseLayout title="Opportunities" description="Student and collaboration inquiries for the Climate Resilient and Equitable Infrastructure Lab.">
  <section class="section">
    <div class="wrap" style="max-width: var(--measure-narrow);">
      <p class="kicker">Opportunities</p>
      <h1>Join the lab</h1>
      <p class="lede">
        Interested in climate hazards, soil mechanics, or equitable infrastructure? Read about our
        research and contact Farshid Vahedifard to discuss your interests.
      </p>
      <h2>Prospective students</h2>
      <p>
        Please review our <a href={sitePath('/projects')}>projects</a> and
        <a href={sitePath('/publications')}>publications</a> before getting in touch. In your email,
        describe your academic background, the degree you hope to pursue, and the research
        questions that interest you. Current openings have not yet been posted on this site.
        Consult Tufts department and program announcements for application requirements and deadlines.
      </p>
      <h2>Research collaboration</h2>
      <p>
        For collaboration inquiries, describe the research question, how it relates to our work,
        and any proposed partners or timeline.
      </p>
      <p>
        Contact: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>
  </section>
</BaseLayout>
