---
import { sitePath } from '../lib/paths';
import { getCollection } from 'astro:content';
import IconLinks from '../components/IconLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CEE_URL, FACULTY_PROFILE_URL, PI_LINKEDIN_URL, SOE_URL, TUFTS_URL } from '../lib/site';

// About = the PI (Joy, 2026-10-15). Lab overview moved to /lab; Teaching folded in here.
// Bio text: Joy's draft (设计网站.md, 2026-10-15), fact-checked; mirrored in docs/about_pi_draft.md.
const pi = (await getCollection('people')).find((p) => p.data.role === 'pi');
const courses = (await getCollection('teaching')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));

const doi = (id: string) => `https://doi.org/${id}`;
// Institutions and bodies named in the bio link to their official sites (first mention only; Joy, 2026-10-15).
const LINKS = {
  unu: 'https://unu.edu/inweh',
  asce: 'https://www.asce.org',
  reportCard: 'https://infrastructurereportcard.org',
  normanMedal: 'https://www.asce.org/career-growth/awards-and-honors/norman-medal',
  wampanoag: 'https://wampanoagtribe-nsn.gov',
  msstate: 'https://www.msstate.edu',
  udel: 'https://www.udel.edu',
  basu: 'https://en.basu.ac.ir',
  kntu: 'https://en.kntu.ac.ir',
};
---

<BaseLayout title="About" description="Farshid Vahedifard, Professor and Louis Berger Chair in Civil and Environmental Engineering at Tufts University.">
  <section class="section">
    <div class="wrap">
      {pi && (
        <div class="profile-head">
          {pi.data.photo && <img src={sitePath(pi.data.photo)} alt={pi.data.name} width="480" height="600" />}
          <div>
            <h1>{pi.data.name}, Ph.D.</h1>
            <p class="profile-lines">
              {pi.data.title}<br />
              <a href={CEE_URL}>Department of Civil and Environmental Engineering</a><br />
              <a href={SOE_URL}>School of Engineering</a>, <a href={TUFTS_URL}>Tufts University</a>
            </p>
            <IconLinks name={pi.data.name} scholar={pi.data.scholar} linkedin={PI_LINKEDIN_URL} email={pi.data.email} />
            <p class="profile-more">
              <a href={FACULTY_PROFILE_URL}>Tufts Faculty Profile</a>
            </p>
          </div>
        </div>
      )}

      <div class="profile-bio pi-bio">
        <p>
          <strong>Farshid Vahedifard</strong> is Professor and Louis Berger Chair in
          <a href={CEE_URL}>Civil and Environmental Engineering</a> at <a href={TUFTS_URL}>Tufts University</a>.
          He also serves as the Lead for Resilient and Equitable Infrastructure at the
          <a href={LINKS.unu}>United Nations University Institute for Water, Environment and Health</a>
          (UNU-INWEH). His work connects geotechnical engineering with climate adaptation and
          environmental justice, addressing how infrastructure and communities can better prepare for
          changing environmental conditions and extreme events.
        </p>
        <p>
          Farshid’s research spans the physical processes that govern infrastructure performance and the
          social conditions that shape its consequences. His fundamental work examines how water, heat,
          and mechanical processes interact in variably saturated soils, influencing the behavior and
          stability of slopes, dams, and levees. Building on this foundation, he studies infrastructure
          resilience under drought, flooding, wildfire, and compound and cascading hazards. His research
          brings together geotechnical engineering, climate science, hydrology, data science, and social
          science to assess risk and inform adaptation, with particular attention to historically
          underserved and socially vulnerable communities.
        </p>
        <p>
          His recent work includes frameworks for equitable and resilient infrastructure
          (<a href={doi('10.1093/pnasnexus/pgae157')}><cite>PNAS Nexus</cite></a>), population disparities near
          Superfund sites and equitable cleanup prioritization
          (<a href={doi('10.1038/s41467-025-63607-8')}><cite>Nature Communications</cite></a>), and water
          infrastructure planning that accounts for population aging
          (<a href={doi('10.1038/s44221-026-00711-z')}><cite>Nature Water</cite></a>). These studies extend
          infrastructure assessment beyond physical performance to consider whom infrastructure serves
          and how investment decisions can address unequal risks and needs. His group is also developing
          NSF-supported hybrid digital twins for levee monitoring and risk assessment, and working with
          the <a href={LINKS.wampanoag}>Wampanoag Tribe</a> to understand erosion at the Aquinnah Cliffs on Martha’s Vineyard. These
          projects combine modeling and environmental observations with practical decision-making and
          community collaboration.
        </p>
        <p>
          Farshid contributes to infrastructure policy through <a href={LINKS.asce}>ASCE</a>’s Committee on America’s
          Infrastructure, including work on the dams and levees chapters of the
          <a href={LINKS.reportCard}><cite>2025 Report Card for America’s Infrastructure</cite></a>. Before joining Tufts in 2023, he spent
          more than a decade at <a href={LINKS.msstate}>Mississippi State University</a>, where he held the CEE Advisory Board
          Endowed Professorship. He is a Fellow of ASCE and received its <a href={LINKS.normanMedal}>Norman Medal</a> in 2022 for
          research on levee fragility under projected future flooding. He was also among the recipients
          of the 2026 ASCE State-of-the-Art of Civil Engineering Award for the book
          <cite>Effects of Climate Change on Life-Cycle Performance of Structures and Infrastructure Systems:
          Safety, Reliability, and Risk</cite>. He earned his Ph.D. in Civil Engineering from the <a href={LINKS.udel}>University
          of Delaware</a> in 2011, following master’s degrees from the University of Delaware and
          <a href={LINKS.basu}>Bu-Ali Sina University</a>, and a bachelor’s degree from
          <a href={LINKS.kntu}>K.N. Toosi University of Technology</a>.
        </p>
        <p>
          To learn more, visit our <a href={sitePath('/projects')}>Projects</a> and
          <a href={sitePath('/publications')}>Publications</a>.
        </p>
      </div>

      <h2>Teaching</h2>
      {courses.length === 0 ? (
        <p class="empty">Course information is not yet available.</p>
      ) : (
        <ul class="course-list">
          {courses.map((course) => (
            <li>
              <strong>{course.data.code ? `${course.data.code}: ${course.data.title}` : course.data.title}</strong>
              {(course.data.term || course.data.year) && <> ({[course.data.term, course.data.year].filter(Boolean).join(' ')})</>}
              {course.data.description && <p>{course.data.description}</p>}
            </li>
          ))}
        </ul>
      )}

      <p class="about-actions">
        Read more <a href={sitePath('/lab')}>about our lab</a>, or see
        <a href={sitePath('/join')}>opportunities</a> to join us.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Readable measure for the long-form bio; spacing between paragraphs rather than indents. */
  .pi-bio {
    margin-top: var(--space-6);
  }
  .profile-more {
    margin: var(--space-4) 0 0;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }
  .pi-bio p {
    margin: 0 0 1.15em;
  }
  .pi-bio p:last-child {
    margin-bottom: 0;
  }
  .pi-bio cite {
    font-style: italic;
  }
  .pi-bio a {
    text-underline-offset: 0.15em;
  }
  .pi-bio + h2 {
    margin-top: var(--space-7);
  }
</style>
