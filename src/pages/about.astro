---
import { sitePath } from '../lib/paths';
import { getCollection } from 'astro:content';
import IconLinks from '../components/IconLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CEE_PROFILE_URL, FACULTY_PROFILE_URL, SCHOLAR_URL } from '../lib/site';

// About = the PI (Joy, 2026-10-15). Lab overview moved to /lab; Teaching folded in here.
const pi = (await getCollection('people')).find((p) => p.data.role === 'pi');
const courses = (await getCollection('teaching')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
---

<BaseLayout title="About" description="Farshid Vahedifard, Professor and Louis Berger Chair in Civil and Environmental Engineering at Tufts University.">
  <section class="section">
    <div class="wrap" style="max-width: 56rem;">
      {pi && (
        <div class="profile-head">
          {pi.data.photo && <img src={sitePath(pi.data.photo)} alt={pi.data.name} width="480" height="600" />}
          <div>
            <h1>{pi.data.name}, Ph.D.</h1>
            <p class="profile-lines">
              {pi.data.title}<br />
              Department of Civil and Environmental Engineering<br />
              School of Engineering, Tufts University
            </p>
            <IconLinks name={pi.data.name} scholar={pi.data.scholar} website={CEE_PROFILE_URL} email={pi.data.email} />
          </div>
        </div>
      )}

      <div class="profile-bio">
        <p>
          Farshid Vahedifard is Professor and Louis Berger Chair in Civil and Environmental
          Engineering at Tufts University. His research connects geotechnical engineering with
          climate change and environmental justice, with a focus on how extreme events affect
          infrastructure and disadvantaged communities.
        </p>
        <p>
          See his <a href={CEE_PROFILE_URL}>Tufts CEE profile</a>,
          <a href={FACULTY_PROFILE_URL}>Tufts faculty profile</a>, or
          <a href={SCHOLAR_URL}>Google Scholar</a> for more.
        </p>
      </div>

      <h2>Teaching</h2>
      {courses.length === 0 ? (
        <p class="empty">Course information is not yet available.</p>
      ) : (
        <ul class="course-list">
          {courses.map((course) => (
            <li>
              <strong>{course.data.code ? `${course.data.code}: ${course.data.title}` : course.data.title}</strong>
              {(course.data.term || course.data.year) && <> ({[course.data.term, course.data.year].filter(Boolean).join(' ')})</>}
              {course.data.description && <p>{course.data.description}</p>}
            </li>
          ))}
        </ul>
      )}

      <p class="about-actions">
        Read more <a href={sitePath('/lab')}>about our lab</a>. Our
        <a href={sitePath('/projects')}>projects</a> and
        <a href={sitePath('/publications')}>publications</a> describe this work in more detail, and
        we welcome <a href={sitePath('/join')}>inquiries</a>.
      </p>
    </div>
  </section>
</BaseLayout>
