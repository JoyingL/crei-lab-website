---
import { getCollection } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import snapshots from '../../data/snapshots.json';
import { sitePath } from '../../lib/paths';
import { groupOf, hasProfile, profilePath, ROLE_LABEL, type Group, type Person } from '../../lib/people';

// Order per Joy (2026-10-15): PI, visiting faculty, postdocs, students, visiting researchers.
const CURRENT: { group: Group; heading: string }[] = [
  { group: 'pi', heading: 'Principal Investigator' },
  { group: 'visiting', heading: 'Visiting Faculty' },
  { group: 'postdoc', heading: 'Postdoctoral Associates' },
  { group: 'phd', heading: 'Ph.D. Students' },
  { group: 'masters', heading: 'Master’s Students' },
  { group: 'visiting-researcher', heading: 'Visiting Researchers' },
  { group: 'collaborator', heading: 'Collaborators' },
];

// Alumni grouped by the section they were in; unknown former role goes last.
const ALUMNI: { key: string; heading: string }[] = [
  { key: 'postdoc', heading: 'Former Postdoctoral Associates' },
  { key: 'phd', heading: 'Former Ph.D. Students' },
  { key: 'masters', heading: 'Former Master’s Students' },
  { key: 'visiting-researcher', heading: 'Former Visiting Researchers' },
  { key: 'other', heading: 'Former Lab Members' },
];

// Longest-serving members first; `order` breaks ties and covers entries without a join year.
const bySeniority = (a: Person, b: Person) =>
  (a.data.since ?? 9999) - (b.data.since ?? 9999) || a.data.order - b.data.order;

const people = await getCollection('people');
const membersOf = (group: Group) => people.filter((p) => groupOf(p) === group).sort(bySeniority);
const current = CURRENT.map((s) => ({ ...s, members: membersOf(s.group) })).filter((s) => s.members.length > 0);
const isFaculty = (g: Group) => g === 'pi' || g === 'visiting';
const faculty = current.filter((s) => isFaculty(s.group));
const others = current.filter((s) => !isFaculty(s.group));
const alumni = membersOf('alumni');
const alumniGroups = ALUMNI.map((g) => ({
  ...g,
  members: alumni.filter((p) => (p.data.formerGroup ?? 'other') === g.key),
})).filter((g) => g.members.length > 0);
// A single unlabeled group needs no sub-heading.
const showAlumniHeadings = !(alumniGroups.length === 1 && alumniGroups[0].key === 'other');

// Snapshots: portrait first so the feature layout puts it on the left.
const isPortrait = (s: { width: number; height: number }) => s.height > s.width;
const shots = [...snapshots].sort((a, b) => Number(isPortrait(b)) - Number(isPortrait(a)));
const featured = shots.length === 3 && shots.filter(isPortrait).length === 1;
---

<BaseLayout title="People" description="Members of the Climate Resilient and Equitable Infrastructure Lab at Tufts University.">
  <section class="section">
    <div class="wrap">
      <h1>People</h1>

      <section class="people-group" aria-labelledby="people-current">
        <h2 id="people-current">Current Members</h2>
        {/* PI and visiting faculty share one row (Joy, 2026-10-15). */}
        {faculty.length > 0 && (
          <div class="people-faculty">
            {faculty.map((s) => (
              <section class="people-subgroup" aria-labelledby={`people-${s.group}`}>
                <h3 id={`people-${s.group}`}>{s.heading}</h3>
                <div class="faculty-cards">
                  {s.members.map((person) => <PersonCard person={person} pi={s.group === 'pi'} />)}
                </div>
              </section>
            ))}
          </div>
        )}
        {others.map((s) => (
          <section class="people-subgroup" aria-labelledby={`people-${s.group}`}>
            <h3 id={`people-${s.group}`}>{s.heading}</h3>
            <div class="people-grid">
              {s.members.map((person) => <PersonCard person={person} />)}
            </div>
          </section>
        ))}
      </section>

      {alumni.length > 0 && (
        <section class="people-group" aria-labelledby="people-alumni">
          <h2 id="people-alumni">Alumni</h2>
          {alumniGroups.map((g) => (
            <section class="people-subgroup" aria-labelledby={showAlumniHeadings ? `alumni-${g.key}` : undefined}>
              {showAlumniHeadings && <h3 id={`alumni-${g.key}`}>{g.heading}</h3>}
              <ul class="alumni-list">
                {g.members.map((p) => {
                  const role = p.data.formerGroup ? ROLE_LABEL[p.data.formerGroup] : undefined;
                  const meta = [role, p.data.years && `(${p.data.years})`].filter(Boolean).join(' ');
                  const href = hasProfile(p) ? sitePath(profilePath(p)) : p.data.website;
                  return (
                    <li>
                      <strong class="alumni-name">{href ? <a href={href}>{p.data.name}</a> : p.data.name}</strong>
                      {meta && <span class="alumni-meta">, {meta}</span>}
                      {p.data.current && <span class="alumni-current">. Currently {p.data.current.replace(/\.$/, '')}.</span>}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </section>
      )}

      {shots.length > 0 && (
        <section class="people-group snapshots" aria-labelledby="people-snapshots">
          <h2 id="people-snapshots">Snapshots from Lab Activities</h2>
          <ul class:list={['snapshot-mosaic', featured ? 'mosaic-feature' : 'mosaic-masonry']}>
            {shots.map((s) => (
              <li class={isPortrait(s) ? 'is-portrait' : 'is-landscape'}>
                <img src={sitePath(s.src)} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Faculty: PI and visiting side by side, each card the width of a grid card plus a bit. */
  .people-faculty {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    margin-bottom: var(--space-5);
  }

  .people-faculty .people-subgroup + .people-subgroup { margin-top: 0; }

  .faculty-cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 14rem;
    gap: var(--space-5);
  }

  .people-faculty :global(.person) { max-width: none; }

  /* Photo-forward grid: fixed-width tracks so a lone member does not stretch across the row. */
  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr));
    gap: var(--space-6) var(--space-5);
    margin-bottom: var(--space-5);
  }

  @media (max-width: 30rem) {
    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }
  }

  .alumni-list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .alumni-list li {
    padding: 0.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .alumni-list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .alumni-name {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .alumni-name a {
    color: var(--color-text);
  }

  .alumni-name a:hover {
    color: var(--color-link);
  }

  .alumni-meta,
  .alumni-current {
    color: var(--color-text-muted);
  }

  /*
   * Snapshots. One portrait + two landscapes: portrait left, landscapes stacked right.
   * Columns 9fr : 8fr make the 3:4 portrait exactly as tall as two stacked 4:3 photos.
   * Any other mix falls back to a masonry column flow that keeps each photo's own ratio.
   */
  .snapshot-mosaic {
    max-width: 50rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .snapshot-mosaic li {
    overflow: hidden;
    background: var(--color-sky);
  }

  .snapshot-mosaic img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mosaic-feature {
    display: grid;
    grid-template-columns: 9fr 8fr;
    gap: var(--space-3);
  }

  .mosaic-feature .is-portrait {
    grid-row: span 2;
  }

  .mosaic-feature .is-portrait img {
    height: 100%;
    object-fit: cover;
  }

  .mosaic-masonry {
    columns: 3 16rem;
    column-gap: var(--space-3);
  }

  .mosaic-masonry li {
    break-inside: avoid;
    margin-bottom: var(--space-3);
  }

  @media (max-width: 40rem) {
    .mosaic-feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .mosaic-feature .is-portrait {
      grid-row: auto;
    }
  }
</style>
