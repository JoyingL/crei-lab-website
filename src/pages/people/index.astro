---
import { sitePath } from '../../lib/paths';
import { getCollection } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const pi = people.filter((p) => p.data.role === 'pi');
const rest = people.filter((p) => p.data.role !== 'pi');
---

<BaseLayout title="People" description="People of the Climate Resilient and Equitable Infrastructure Lab at Tufts.">
  <section class="section">
    <div class="wrap">
      <h1>People</h1>
      <p class="lede">
        Farshid Vahedifard leads the lab in the Department of Civil and Environmental Engineering
        at Tufts University.
      </p>

      <h2>Principal investigator</h2>
      {
        pi.length === 0 ? (
          <p class="empty">The principal investigator profile is being prepared.</p>
        ) : (
          <div class="grid grid-people">
            {pi.map((person) => <PersonCard person={person} />)}
          </div>
        )
      }

      <h2>Lab members</h2>
      {
        rest.length === 0 ? (
          <p class="empty">
            Student and collaborator profiles will be added as their details are confirmed.
          </p>
        ) : (
          <div class="grid grid-people">
            {rest.map((person) => (
              <PersonCard person={person} />
            ))}
          </div>
        )
      }
      <p>
        Interested in working with the lab? See <a href={sitePath('/join')}>Opportunities</a>.
      </p>
    </div>
  </section>
</BaseLayout>
