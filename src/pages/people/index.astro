---
import { getCollection } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import snapshots from '../../data/snapshots.json';
import { sitePath } from '../../lib/paths';
import { groupOf, hasProfile, profilePath, ROLE_LABEL, type Group, type Person } from '../../lib/people';

// Current members in one list, no role sub-headings (each card already shows the role; Joy, 2026-10-15).
// Order: faculty row, then postdocs, Ph.D. candidates, Ph.D. students, master's, visiting researchers.
const RANK: Record<string, number> = { postdoc: 0, phdCandidate: 1, phd: 2, masters: 3, 'visiting-researcher': 4, collaborator: 5 };
const rankOf = (p: Person) => {
  const g = groupOf(p);
  return RANK[g === 'phd' && /candidate/i.test(p.data.title) ? 'phdCandidate' : g] ?? 9;
};

// Alumni in one list without sub-headings (Joy, 2026-10-15), ordered by former role; unknown role last.
const ALUMNI_ORDER = ['postdoc', 'phd', 'masters', 'visiting-researcher', 'other'];

// Within a rank, `order` (set in each person's file) decides; join year breaks ties.
const byOrder = (a: Person, b: Person) =>
  a.data.order - b.data.order || (a.data.since ?? 9999) - (b.data.since ?? 9999);

const people = await getCollection('people');
const membersOf = (group: Group) => people.filter((p) => groupOf(p) === group).sort(byOrder);
// Faculty row: PI first, then visiting faculty.
const faculty = [...membersOf('pi'), ...membersOf('visiting')];
const isCurrentMember = (p: Person) => !['pi', 'visiting', 'alumni'].includes(groupOf(p));
const members = people.filter(isCurrentMember).sort((a, b) => rankOf(a) - rankOf(b) || byOrder(a, b));
const alumni = membersOf('alumni');
const alumniRank = (p: Person) => ALUMNI_ORDER.indexOf(p.data.formerGroup ?? 'other');
const alumniList = [...alumni].sort((a, b) => alumniRank(a) - alumniRank(b));

// Snapshots: portrait first so the feature layout puts it on the left.
const isPortrait = (s: { width: number; height: number }) => s.height > s.width;
const shots = [...snapshots].sort((a, b) => Number(isPortrait(b)) - Number(isPortrait(a)));
const featured = shots.length === 3 && shots.filter(isPortrait).length === 1;
---

<BaseLayout title="People" description="Members of the Climate Resilient and Equitable Infrastructure Lab at Tufts University.">
  <section class="section">
    <div class="wrap">
      <h1>People</h1>

      <section class="people-group" aria-labelledby="people-current">
        <h2 id="people-current">Current Members</h2>
        {/* PI and visiting faculty share the first row (Joy, 2026-10-15). */}
        {faculty.length > 0 && (
          <div class="people-faculty">
            {faculty.map((person) => <PersonCard person={person} pi={groupOf(person) === 'pi'} />)}
          </div>
        )}
        {members.length > 0 && (
          <div class="people-grid">
            {members.map((person) => <PersonCard person={person} />)}
          </div>
        )}
      </section>

      {alumni.length > 0 && (
        <section class="people-group" aria-labelledby="people-alumni">
          <h2 id="people-alumni">Alumni</h2>
          <ul class="alumni-list">
            {alumniList.map((p) => {
              const role = p.data.formerGroup ? ROLE_LABEL[p.data.formerGroup] : undefined;
              const meta = [role, p.data.years && `(${p.data.years})`].filter(Boolean).join(' ');
              const href = hasProfile(p) ? sitePath(profilePath(p)) : p.data.website;
              return (
                <li>
                  <strong class="alumni-name">{href ? <a href={href}>{p.data.name}</a> : p.data.name}</strong>
                  {meta && <span class="alumni-meta">, {meta}</span>}
                  {p.data.current && <span class="alumni-current">. Currently {p.data.current.replace(/\.$/, '')}.</span>}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {shots.length > 0 && (
        <section class="people-group snapshots" aria-labelledby="people-snapshots">
          <h2 id="people-snapshots">Snapshots from Lab Activities</h2>
          <ul class:list={['snapshot-mosaic', featured ? 'mosaic-feature' : 'mosaic-masonry']}>
            {shots.map((s) => (
              <li class={isPortrait(s) ? 'is-portrait' : 'is-landscape'}>
                <img src={sitePath(s.src)} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Faculty row: PI and visiting side by side, wider than member cards, with generous space between. */
  .people-faculty {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 18rem));
    gap: var(--space-6) var(--space-8);
    margin-bottom: var(--space-7);
  }

  .people-faculty :global(.person) { max-width: none; }

  /* Photo-forward grid: cards fill their columns (4 across at full width), 2.5rem gutters. */
  .people-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 2.5rem 2.5rem;
    margin-bottom: var(--space-5);
  }

  @media (max-width: 30rem) {
    .people-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) var(--space-4);
    }
  }

  .alumni-list {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52rem;
  }

  .alumni-list li {
    padding: 0.5rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .alumni-list li:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  .alumni-name {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .alumni-name a {
    color: var(--color-text);
  }

  .alumni-name a:hover {
    color: var(--color-link);
  }

  .alumni-meta,
  .alumni-current {
    color: var(--color-text-muted);
  }

  /*
   * Snapshots. One portrait + two landscapes: portrait left, landscapes stacked right.
   * Columns 9fr : 8fr make the 3:4 portrait exactly as tall as two stacked 4:3 photos.
   * Any other mix falls back to a masonry column flow that keeps each photo's own ratio.
   */
  .snapshot-mosaic {
    max-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .snapshot-mosaic li {
    overflow: hidden;
    background: var(--color-sky);
  }

  .snapshot-mosaic img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mosaic-feature {
    display: grid;
    grid-template-columns: 9fr 8fr;
    gap: var(--space-3);
  }

  .mosaic-feature .is-portrait {
    grid-row: span 2;
  }

  .mosaic-feature .is-portrait img {
    height: 100%;
    object-fit: cover;
  }

  .mosaic-masonry {
    columns: 3 16rem;
    column-gap: var(--space-3);
  }

  .mosaic-masonry li {
    break-inside: avoid;
    margin-bottom: var(--space-3);
  }

  @media (max-width: 40rem) {
    .mosaic-feature {
      grid-template-columns: minmax(0, 1fr);
    }

    .mosaic-feature .is-portrait {
      grid-row: auto;
    }
  }
</style>
