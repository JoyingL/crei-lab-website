---
import { sitePath } from '../../lib/paths';
import { getCollection } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const pi = people.filter((p) => p.data.role === 'pi');
const isVisiting = (p: (typeof people)[number]) => /visiting/i.test(p.data.title);
const visiting = people.filter((p) => p.data.role !== 'pi' && isVisiting(p));
const rest = people.filter((p) => p.data.role !== 'pi' && !isVisiting(p));
---

<BaseLayout title="People" description="Members of the Climate Resilient and Equitable Infrastructure Lab at Tufts University.">
  <section class="section">
    <div class="wrap">
      <h1>People</h1>
      <p class="lede">
        Farshid Vahedifard leads the lab in the Department of Civil and Environmental Engineering
        at Tufts University.
      </p>

      <h2>Principal investigator</h2>
      {
        pi.length === 0 ? (
          <p class="empty">Profile not yet available.</p>
        ) : (
          <div class="grid grid-people">
            {pi.map((person) => <PersonCard person={person} />)}
          </div>
        )
      }

      {visiting.length > 0 && (
        <section aria-labelledby="visiting-heading">
          <h2 id="visiting-heading">Visiting faculty</h2>
          <div class="grid grid-people">
            {visiting.map((person) => <PersonCard person={person} />)}
          </div>
        </section>
      )}

      {rest.length > 0 && (
        <section aria-labelledby="members-heading">
          <h2 id="members-heading">Lab members</h2>
          <div class="grid grid-people">
            {rest.map((person) => <PersonCard person={person} />)}
          </div>
        </section>
      )}
      <p>
        Information for prospective students and researchers is on the
        <a href={sitePath('/join')}>Opportunities</a> page.
      </p>
    </div>
  </section>
</BaseLayout>
