---
import { sitePath } from '../../lib/paths';
import { getCollection, type CollectionEntry } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Person = CollectionEntry<'people'>;
type Group = NonNullable<Person['data']['group']>;

// Section order follows HuMNet: PI, students, then visiting faculty, collaborators, alumni.
const SECTIONS: { group: Group; heading: string }[] = [
  { group: 'pi', heading: 'Principal investigator' },
  { group: 'phd', heading: 'Ph.D. students' },
  { group: 'masters', heading: 'Master’s students' },
  { group: 'visiting', heading: 'Visiting faculty' },
  { group: 'collaborator', heading: 'Collaborators' },
  { group: 'alumni', heading: 'Alumni' },
];

const ROLE_FALLBACK: Record<Person['data']['role'], Group> = {
  pi: 'pi',
  student: 'phd',
  researcher: 'collaborator',
  staff: 'collaborator',
  alumni: 'alumni',
};

const groupOf = (p: Person): Group => p.data.group ?? ROLE_FALLBACK[p.data.role];

// Longest-serving members first; `order` breaks ties and covers entries without a join year.
const bySeniority = (a: Person, b: Person) =>
  (a.data.since ?? 9999) - (b.data.since ?? 9999) || a.data.order - b.data.order;

const people = await getCollection('people');
const sections = SECTIONS.map((s) => ({
  ...s,
  members: people.filter((p) => groupOf(p) === s.group).sort(bySeniority),
})).filter((s) => s.members.length > 0);
---

<BaseLayout title="People" description="Members of the Climate Resilient and Equitable Infrastructure Lab at Tufts University.">
  <section class="section">
    <div class="wrap">
      <h1>People</h1>
      <p class="lede">
        Farshid Vahedifard leads the lab in the Department of Civil and Environmental Engineering
        at Tufts University.
      </p>

      {sections.map((s) => (
        <section class="people-section" aria-labelledby={`people-${s.group}`}>
          <h2 id={`people-${s.group}`}>{s.heading}</h2>
          <div class="grid grid-people">
            {s.members.map((person) => <PersonCard person={person} />)}
          </div>
        </section>
      ))}

      <p>
        Information for prospective students and researchers is on the
        <a href={sitePath('/join')}>Opportunities</a> page.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .people-section + .people-section { margin-top: var(--space-6); }
</style>
