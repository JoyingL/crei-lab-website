---
import { sitePath } from '../lib/paths';
import { getCollection } from 'astro:content';
import AreaCard from '../components/AreaCard.astro';
import PersonCard from '../components/PersonCard.astro';
import ProjectPlaceholders from '../components/ProjectPlaceholders.astro';
import HighlightTabs from '../components/HighlightTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_SUBTITLE, LAB_NAME, RESEARCH_AREAS } from '../lib/site';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={LAB_NAME}
  description="The Climate Resilient and Equitable Infrastructure Lab at Tufts University studies how climate extremes affect earthen infrastructure and the communities it serves."
>
  <section class="hero">
    <img class="hero-map" src={sitePath('/world-map.svg')} alt="" aria-hidden="true" width="1440" height="600" />
    <div class="wrap">
      <h1 class="hero-name"><span>Climate Resilient and Equitable</span>{' '}<span>Infrastructure Lab</span></h1>
      <p class="lede">{HOME_SUBTITLE}</p>
      <a class="btn" href={sitePath('/about')}>About the lab</a>
    </div>
  </section>

  <section class="section" aria-labelledby="areas-heading">
    <div class="wrap">
      <h2 id="areas-heading" class="section-title">Research areas</h2>
      <div class="grid grid-areas">
        {
          RESEARCH_AREAS.map((area) => (
            <AreaCard title={area.title} body={area.body} hover={area.hover} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-band" aria-labelledby="projects-heading">
    <div class="wrap">
      <h2 id="projects-heading" class="section-title">Highlighted projects</h2>
      <ProjectPlaceholders />
      <p class="section-more"><a class="more-link" href={sitePath('/projects')}>All projects</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="people-heading">
    <div class="wrap">
      <h2 id="people-heading" class="section-title">People</h2>
      {
        people.length === 0 ? (
          <p class="empty">Member profiles are not yet available.</p>
        ) : (
          <div class="grid grid-people">
            {people.map((person) => <PersonCard person={person} />)}
          </div>
        )
      }
      <p class="section-more"><a class="more-link" href={sitePath('/people')}>All people</a></p>
    </div>
  </section>

  <section class="section section-band" aria-labelledby="pubs-heading">
    <div class="wrap">
      <h2 id="pubs-heading" class="section-title">Highlighted publications</h2>
      <HighlightTabs />
      <p class="section-more"><a class="more-link" href={sitePath('/publications')}>All publications</a></p>
    </div>
  </section>
</BaseLayout>
