---
import { sitePath } from '../lib/paths';
import { getCollection } from 'astro:content';
import AreaCard from '../components/AreaCard.astro';
import PersonCard from '../components/PersonCard.astro';
import ProjectPlaceholders from '../components/ProjectPlaceholders.astro';
import PubItem from '../components/PubItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_SUBTITLE, LAB_NAME, RESEARCH_AREAS } from '../lib/site';

const people = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const pubs = (await getCollection('publications'))
  .filter((p) => p.data.highlight)
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title={LAB_NAME}
  description="Climate Resilient and Equitable Infrastructure Lab at Tufts University School of Engineering."
>
  <section class="hero">
    <img class="hero-map" src={sitePath('/world-map.svg')} alt="" aria-hidden="true" width="1440" height="600" />
    <div class="wrap">
      <h1 class="hero-name"><span>Climate Resilient and Equitable</span>{' '}<span>Infrastructure Lab</span></h1>
      <p class="lede">{HOME_SUBTITLE}</p>
      <a class="btn" href={sitePath('/about')}>About the lab</a>
    </div>
  </section>

  <section class="section" aria-labelledby="areas-heading">
    <div class="wrap">
      <h2 id="areas-heading">Research areas</h2>
      <div class="grid grid-3">
        {
          RESEARCH_AREAS.map((area) => (
            <AreaCard title={area.title} body={area.body} hover={area.hover} chips={area.chips} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-band" aria-labelledby="projects-heading">
    <div class="wrap">
      <h2 id="projects-heading">Highlighted projects</h2>
      <ProjectPlaceholders />
      <p><a href={sitePath('/projects')}>All projects</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="people-heading">
    <div class="wrap">
      <h2 id="people-heading">People</h2>
      {
        people.length === 0 ? (
          <p class="empty">
            For research inquiries, contact Farshid Vahedifard.
          </p>
        ) : (
          <div class="grid grid-people">
            {people.map((person) => <PersonCard person={person} />)}
          </div>
        )
      }
      <p><a href={sitePath('/people')}>Lab members</a></p>
    </div>
  </section>

  <section class="section section-band" aria-labelledby="pubs-heading">
    <div class="wrap">
      <h2 id="pubs-heading">Highlighted publications</h2>
      {
        pubs.length === 0 ? (
          <p class="empty">Explore our research on the Publications page.</p>
        ) : (
          pubs.map((pub) => <PubItem pub={pub} />)
        )
      }
      <p><a href={sitePath('/publications')}>View more publications</a></p>
    </div>
  </section>
</BaseLayout>
