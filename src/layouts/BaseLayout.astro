---
import { ClientRouter } from 'astro:transitions';
import { sitePath, localPath } from '../lib/paths';
import '../styles/global.css';
import {
  CEE_URL,
  EMAIL,
  LAB_NAME,
  LAB_SHORT,
  MAPS_URL,
  PRIMARY_NAV,
  SCHOLAR_URL,
  TUFTS_URL,
  isCurrentPath,
} from '../lib/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${LAB_NAME} at Tufts University.` } = Astro.props;
const path = localPath(Astro.url.pathname);
const pageTitle = title.includes(LAB_SHORT) ? title : `${title} · ${LAB_SHORT}`;

// Keyframes live in global.css; header and footer are excluded so only content moves.
const pageOut = { name: 'page-out', duration: '200ms', easing: 'ease-in', fillMode: 'both' };
const pageIn = { name: 'page-in', duration: '420ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' };
const pageAnimation = {
  forwards: { old: pageOut, new: pageIn },
  backwards: { old: pageOut, new: pageIn },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href={sitePath('/sitemap-index.xml')} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="inst-bar">
      <div class="wrap-wide inst-inner">
        <nav class="inst-links" aria-label="Institution">
          <a class="institution-logo" href={TUFTS_URL}><img src={sitePath('/brand/tufts-white.png')} alt="Tufts University" width="394" height="169" /></a>
          <a class="department-logo" href={CEE_URL}><img src={sitePath('/brand/cee-department-white.png')} alt="Tufts Civil and Environmental Engineering" width="1086" height="122" /></a>
        </nav>
        <form class="inst-search" action={sitePath('/search')} method="get" role="search" data-search>
          <label class="visually-hidden" for="q">Search this site</label>
          <input id="q" name="q" type="search" placeholder="Search this site" autocomplete="off" />
          <button type="submit" aria-label="Search this site">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M15.5 15.5 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
        </form>
      </div>
    </div>

    <header class="site-header">
      <div class="wrap-wide lab-bar">
        <a class="wordmark" href={sitePath('/')}>{LAB_NAME}</a>
        <nav aria-label="Primary navigation">
          <ul class="lab-nav">
            {
              PRIMARY_NAV.map((item) => (
                <li>
                  <a
                    href={sitePath(item.href)}
                    aria-current={isCurrentPath(path, item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" transition:name="page" transition:animate={pageAnimation}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <a
            class="footer-logo"
            href={TUFTS_URL}
            style={`--logo: url('${sitePath('/brand/tufts-white.png')}')`}
          >
            <img src={sitePath('/brand/tufts-white.png')} alt="Tufts University" width="394" height="169" />
          </a>
          <p class="footer-lab">
            {LAB_NAME}<br />
            Department of Civil and Environmental Engineering
          </p>
        </div>
        <div>
          <h2 class="footer-heading">Visit Us</h2>
          <address class="footer-address">
            School of Engineering<br />
            200 College Avenue<br />
            Medford, MA 02155<br />
            United States
          </address>
          <a class="footer-map" href={MAPS_URL}>Campus Map</a>
        </div>
        <nav aria-label="Footer">
          <h2 class="footer-heading">Explore</h2>
          <ul class="footer-list">
            {
              PRIMARY_NAV.filter((item) => item.href !== '/').map((item) => (
                <li>
                  <a href={sitePath(item.href)}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          <h2 class="footer-heading">Connect</h2>
          <ul class="footer-list">
            <li><a href={sitePath('/join')}>Opportunities</a></li>
            <li><a href={sitePath('/contact')}>Contact</a></li>
            <li><a href={SCHOLAR_URL}>Google Scholar</a></li>
            <li><a href={`mailto:${EMAIL}`}>Email</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <p class="copyright">© 2026 {LAB_NAME}, Tufts University. All rights reserved.</p>
        <a class="to-top" href="#main">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // Scroll reveal with stagger. Content is visible without JS; `js-reveal` gates the hidden state.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const TARGETS = '.section > .wrap > h1, .section > .wrap > h2, .section > .wrap > .lede, .grid > *, .project-cards > *, .highlight-tabs';

  function reveal(el: Element) {
    el.classList.add('is-visible');
    // Drop the reveal hooks after entry so hover transforms stay snappy.
    const done = (event: Event) => {
      if (event.target !== el) return; // ignore transitions bubbling from children
      el.removeEventListener('transitionend', done);
      el.removeAttribute('data-reveal');
      el.classList.remove('is-visible');
      (el as HTMLElement).style.removeProperty('--i');
    };
    el.addEventListener('transitionend', done);
  }

  function setup() {
    const root = document.documentElement;
    if (reducedMotion.matches || !('IntersectionObserver' in window)) {
      root.classList.remove('js-reveal');
      return;
    }
    root.classList.add('js-reveal');
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        reveal(entry.target);
      }
    }, { rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('main').forEach((main) => {
      main.querySelectorAll(TARGETS).forEach((el) => {
        // Above-the-fold content already animates with the page transition; never hide it.
        if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
        const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
        const isGridItem = el.parentElement?.matches('.grid, .project-cards');
        el.setAttribute('data-reveal', '');
        if (isGridItem) (el as HTMLElement).style.setProperty('--i', String(siblings.indexOf(el) % 4));
        observer.observe(el);
      });
    });
  }

  // Keyboard users never land on invisible content. Registered once; document persists across swaps.
  document.addEventListener('focusin', (event) => {
    const hidden = (event.target as Element | null)?.closest?.('[data-reveal]:not(.is-visible)');
    if (hidden) reveal(hidden);
  });

  document.addEventListener('astro:page-load', setup);

  // Header search: icon-only until opened. Without JS the field is always visible.
  function setupSearch() {
    const form = document.querySelector<HTMLFormElement>('[data-search]');
    const input = form?.querySelector<HTMLInputElement>('input');
    if (!form || !input) return;
    form.classList.add('is-collapsible');
    const open = () => { form.classList.add('is-open'); input.focus(); };
    const close = () => { if (!input.value) form.classList.remove('is-open'); };
    form.addEventListener('submit', (event) => {
      // First click on the icon opens the field instead of submitting an empty query.
      if (!form.classList.contains('is-open') || !input.value.trim()) { event.preventDefault(); open(); }
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { input.value = ''; close(); (form.querySelector('button') as HTMLElement).focus(); }
    });
    form.addEventListener('focusout', (event) => {
      if (!form.contains(event.relatedTarget as Node | null)) close();
    });
  }

  document.addEventListener('astro:page-load', setupSearch);
</script>
